{
  "oscPort": 9111,
  "httpPort": 8181,

  "inputs": {
    "osc": false,
    "psn": true
  },
  "psn": { "group": "236.10.10.10", "port": 56565 },

  "stage": {
    "width": 3.66,
    "depth": 3.66,
    "height": 3,
    "origin": "downstage-centre",
    "position": [0, 0],
    "rotation": 0
  },

  "transform": {
    "x": "x",
    "y": "y",
    "z": "z",
    "scale": 1,
    "offset": [0, 0, 0]
  },

  "mappings": [
    { "address": "/psn/{id}/pos", "args": ["x", "y", "z"] },
    { "address": "/kratos/targets/{id}/position", "args": ["x", "y", "z"] },
    { "address": "/pos/xyz", "id": "xyz", "args": ["x", "y", "z"] },
    { "address": "/pos/xy", "id": "xyz", "args": ["x", "y"] },
    { "address": "/pos/x", "id": "xyz", "args": ["x"] },
    { "address": "/pos/y", "id": "xyz", "args": ["y"] },
    { "address": "/pos/z", "id": "xyz", "args": ["z"] },
    { "address": "/tracker/{id}/pos", "args": ["x", "y", "z"] },
    { "address": "/tracker/{id}/x", "args": ["x"] },
    { "address": "/tracker/{id}/y", "args": ["y"] },
    { "address": "/tracker/{id}/z", "args": ["z"] }
  ],

  "names": {},

  "trailSeconds": 3,
  "staleMs": 1500
}
